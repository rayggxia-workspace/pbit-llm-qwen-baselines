#!/usr/bin/env bash
# Copy OUTSIDE the source package; edit your local setup and one .db path.
# No proprietary library/model is copied into the result archive.
# source /absolute/path/to/your/synopsys_setup.sh
export STD_DB=/absolute/path/to/your/55nm_ss_1p08v_125c.db
export STD_REF_CELL=${STD_REF_CELL:-INVX1_9TSVT}
# Tool executables default to PATH. Optional overrides:
# export DC_SHELL=/absolute/path/to/dc_shell
# export PT_SHELL=/absolute/path/to/pt_shell
# export PYTHON=python3
# For TT, supply its .db and invoke --corner tt. Filename alone is NOT PVT proof.
